<mxfile host="drawio"><diagram id="arq" name="Arquitetura"><mxGraphModel dx="1400" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="700" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n11" value="Grana Amiga · Medidor de energia IoT — arquitetura e comunicação em rede" style="text;html=1;whiteSpace=wrap;fontSize=20;fontColor=#0B1F3A;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="30" as="geometry"/></mxCell><mxCell id="n12" value="Caminho do dado: corrente elétrica → ESP32 (edge) → Wi-Fi → roteador → Internet → broker MQTT → Node-RED → API Java → app da família" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#495057;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1300" height="22" as="geometry"/></mxCell><mxCell id="n13" value="① Casa da família (borda / edge)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#1971C2;fontColor=#1971C2;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;arcSize=3;dashed=0;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="420" height="560" as="geometry"/></mxCell><mxCell id="n14" value="Sensor SCT-013-030&lt;br&gt;alicate não invasivo, 0–30 A&lt;br&gt;GPIO34 (ADC1) · RMS de 2000 amostras&lt;br&gt;No Wokwi: potenciômetro" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#1971C2;fontColor=#0B1F3A;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="200" height="90" as="geometry"/></mxCell><mxCell id="n15" value="ESP32 DevKit&lt;br&gt;(framework Arduino)&lt;br&gt;&lt;br&gt;Irms → W → kWh → R$&lt;br&gt;faixa da meta&lt;br&gt;buffer offline (60 leituras)&lt;br&gt;relógio NTP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1971C2;strokeColor=#1971C2;fontColor=#FFFFFF;fontSize=11;a