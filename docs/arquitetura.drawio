ent="1"><mxGeometry x="670" y="120" width="360" height="80" as="geometry"/></mxCell><mxCell id="n33" value="Tópicos  granaamiga/casa/{codigo}/…&lt;br&gt;• energia — leitura JSON a cada 5 s (ESP32 → nuvem)&lt;br&gt;• alerta — mudança de faixa&lt;br&gt;• status — online / offline (Last Will, retido)&lt;br&gt;• fechamento — resumo do mês&lt;br&gt;• config — meta, tarifa, tensão (nuvem → ESP32)&lt;br&gt;• config/ack — confirmação do medidor" style="text;html=1;whiteSpace=wrap;fontSize=10;fontColor=#0B1F3A;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="675" y="460" width="360" height="130" as="geometry"/></mxCell><mxCell id="n34" value="Node-RED (container Docker)&lt;br&gt;valida JSON · métricas de entrega&lt;br&gt;dashboard /ui · CSV de leituras&lt;br&gt;formulário de configuração · ponte HTTP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1971C2;fontColor=#0B1F3A;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="670" y="250" width="360" height="85" as="geometry"/></mxCell><mxCell id="n35" value="API Java (Spring Boot)&lt;br&gt;JWT + POST&lt;br&gt;/api/v1/dispositivos/{id}/leituras" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1971C2;fontColor=#0B1F3A;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="670" y="370" width="190" height="70" as="geometry"/></mxCell><mxCell id="n36" value="Oracle&lt;br&gt;tabela leitura_energia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1971C2;fontColor=#0B1F3A;fontSize=11;arcSize=8;shape=cylinder3;boundedLbl=1;size=10;" vertex="1" parent="1"><mxGeometry x="905" y="370" width="125" height="70" as="geometry"/></mxCell><mxCell id="n37" value="subscribe …/+/#" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0B1F3A;fontColor=#0B1F3A;fontSize=10;strokeWidth=1.6;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.35;exitY=1;exitDx=0;exitDy=0;entryX=0.35;entryY=0;entryDx=0;entryDy=0;" edge="1" parent