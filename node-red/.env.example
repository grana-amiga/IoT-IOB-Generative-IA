# Copie para .env (que está no .gitignore) e ajuste se precisar.
# Broker MQTT: o mesmo que o ESP32 usa
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
# Código do medidor que recebe os comandos do formulário do dashboard
DISPOSITIVO=GA-ESP32-001

# API Java do Grana Amiga (repositório Java-Advanced)
# API rodando no mesmo PC, fora do Docker: http://host.docker.internal:8080
API_URL=http://host.docker.internal:8080
# Conta da família na API (crie em POST /api/v1/auth/cadastro). Sem isso a ponte fica parada.
API_TELEFONE=
API_SENHA=
