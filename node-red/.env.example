# Copie para .env (que está no .gitignore) e ajuste se precisar.
# Broker MQTT: o mesmo que o ESP32 usa
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
# Código do medidor que recebe os comandos do formulário do dashboard
DISPOSITIVO=GA-ESP32-001
# API Java do Grana Amiga (ponte HTTP, nó desativado até o endpoint existir)
API_URL=http://localhost:8080
